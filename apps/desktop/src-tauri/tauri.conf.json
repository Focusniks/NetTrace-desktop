{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetTrace",
  "mainBinaryName": "nettrace",
  "version": "1.0.0",
  "identifier": "ru.nettrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetTrace — анализатор сетевого трафика",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#15181d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true,
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Анализатор сетевого трафика",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pcap",
          "pcapng",
          "cap"
        ],
        "name": "Packet capture",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Focusniks",
    "homepage": "https://github.com/Focusniks/NetTrace-desktop",
    "copyright": "© 2026 Focusniks и участники проекта NetTrace",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "installer/LICENSE.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMjNBNkU0NzhCQjU1MzAKUldRd1ZidDQ1S1lqbmQ3WWFPUTRLdW9VSzRXcWhYK2ZTWWJiQnBVaUtpKy9GYUVWS2lWY0o5cGwK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Focusniks/NetTrace-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
